<https://w3id.org/sef-medfusion/research> a owl:Ontology ;
    rdfs:label "SeF-MedFusion research vocabulary (local proposal; namespace not registered)" .

med:M a owl:DatatypeProperty ;
    rdfs:range xsd:string .

med:N a owl:DatatypeProperty ;
    rdfs:range xsd:string .

med:T a owl:DatatypeProperty ;
    rdfs:range xsd:string .

med:adversarialScore a owl:DatatypeProperty ;
    rdfs:range xsd:double .

med:classLabel a owl:DatatypeProperty ;
    rdfs:range xsd:string .

med:confidence a owl:DatatypeProperty ;
    rdfs:range xsd:double .

med:configuration a owl:DatatypeProperty ;
    rdfs:range xsd:string .

med:dataset a owl:ObjectProperty ;
    rdfs:range med:Dataset .

med:externalTNM a owl:ObjectProperty ;
    rdfs:range med:ExternalTNM .

med:flagged a owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

med:gradientNorm a owl:DatatypeProperty ;
    rdfs:range xsd:double .

med:inputCondition a owl:DatatypeProperty ;
    rdfs:range xsd:string .

med:model a owl:ObjectProperty ;
    rdfs:domain med:Prediction ;
    rdfs:range med:Model .

med:sample a owl:ObjectProperty ;
    rdfs:domain med:Prediction ;
    rdfs:range med:Sample .

med:seed a owl:DatatypeProperty ;
    rdfs:range xsd:integer .

med:sha256 a owl:DatatypeProperty ;
    rdfs:range xsd:string .

med:stageStatus a owl:DatatypeProperty ;
    rdfs:range xsd:string .

med:stagingEdition a owl:DatatypeProperty ;
    rdfs:range xsd:string .

med:stagingSystem a owl:DatatypeProperty ;
    rdfs:range xsd:string .

